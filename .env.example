# Copy to .env (never commit .env) and `set -a; source .env; set +a` before `uv run ga4-mcp`.

# --- GA4 ---
GA4_PROPERTIES_FILE=properties.yaml
# Local dev: ADC from `gcloud auth application-default login --scopes=https://www.googleapis.com/auth/analytics.readonly,https://www.googleapis.com/auth/cloud-platform`
# or impersonate the runtime service account (see README).
# Whose GA4 access to use: adc (default) | delegated | user_token
# GA_AUTH_MODE=delegated
# GA_DELEGATED_SUBJECT=<shared-mailbox>
# GA_SERVICE_ACCOUNT_EMAIL=ga4-mcp-runtime@PROJECT.iam.gserviceaccount.com
# GA_AUTH_MODE=user_token
# GA_USER_TOKEN_FILE=/path/to/authorized_user.json

# --- Server ---
PORT=8080
# true = stateless Streamable HTTP (recommended on Cloud Run, any instance can serve any request)
MCP_STATELESS_HTTP=true
LOG_LEVEL=INFO
# LOG_FORMAT=json   # JSON logs locally (always JSON on Cloud Run)

# --- Local dev without login (refused when K_SERVICE is set, i.e. on Cloud Run) ---
AUTH_DISABLED=true

# --- Google sign-in (needed when AUTH_DISABLED is not true) ---
ALLOWED_DOMAINS=anga.co.th
BASE_URL=http://localhost:8080
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxx
# Require the Google Workspace `hd` claim (blocks consumer Google accounts). Keep true.
REQUIRE_WORKSPACE_HD=true
# Emails that may NOT sign in (shared mailboxes). GA_DELEGATED_SUBJECT is always blocked too.
# DENIED_EMAILS=<shared-mailbox>
# Comma-separated redirect URI patterns MCP clients may register (default: claude.ai, claude.com, localhost)
# ALLOWED_CLIENT_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost:*

# Long random string; must stay the same across restarts/instances. `openssl rand -base64 48`
JWT_SIGNING_KEY=

# --- OAuth state storage ---
# memory (local dev) | file (single host) | firestore (Cloud Run)
STORAGE_BACKEND=memory
# STORAGE_DIR=.oauth-storage
# FIRESTORE_PROJECT=my-gcp-project
# FIRESTORE_DATABASE=(default)
# FIRESTORE_COLLECTION_PREFIX=ga4mcp
# Fernet key(s), comma-separated for rotation (first encrypts). Required for file/firestore.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=
